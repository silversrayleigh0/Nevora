rules_version = '2';

// Each person can read and write only their own data. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['account', 'profile', 'insights', 'updatedAt']);

      match /applications/{appId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.id == appId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200
          && request.resource.data.jdText is string
          && request.resource.data.jdText.size() <= 20000;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
