# ---- Firebase web app (optional) ----
# Defaults to the nevora-f6289 project in shared/firebaseConfig.ts.
# Set these only to point a build at a different Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---- Server only (never prefix these with VITE_) ----
# Claude API key (primary AI): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional Claude model override.
ANTHROPIC_MODEL=claude-opus-5-5
# OpenRouter key (fallback AI): https://openrouter.ai/keys — set a credit limit on it.
OPENROUTER_API_KEY=
# Optional backup OpenRouter keys, tried in order if the one before fails (e.g. out of credits).
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
# Optional model overrides (OpenRouter model IDs).
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_MODEL_QUICK=anthropic/claude-haiku-4.5
# Optional comma-separated models to try if the main one is unavailable.
OPENROUTER_FALLBACK_MODELS=
# Used to verify sign-in tokens. Defaults to the project in shared/firebaseConfig.ts.
FIREBASE_PROJECT_ID=
# Your public URL, sent to OpenRouter for attribution.
APP_URL=https://your-app.vercel.app
# AI requests allowed per user per hour (per server instance).
AI_REQUESTS_PER_HOUR=80

# ---- LinkedIn connect (optional) ----
# From a LinkedIn developer app with the "Sign In with LinkedIn using OpenID Connect" product.
# Add https://<your-domain>/api/linkedin as an authorized redirect URL in that app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional; defaults to <APP_URL or request origin>/api/linkedin.
LINKEDIN_REDIRECT_URI=
