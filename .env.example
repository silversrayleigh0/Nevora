# ---- Firebase web app (Project settings → General → Your apps → Web app) ----
# These are public identifiers, safe to ship in the browser bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# ---- Server only (never prefix these with VITE_) ----
# OpenRouter key: https://openrouter.ai/keys — set a credit limit on it.
OPENROUTER_API_KEY=
# Optional model overrides (OpenRouter model IDs).
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_MODEL_QUICK=anthropic/claude-haiku-4.5
# Optional comma-separated models to try if the main one is unavailable.
OPENROUTER_FALLBACK_MODELS=
# Used to verify sign-in tokens. Defaults to VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
# Your public URL, sent to OpenRouter for attribution.
APP_URL=https://your-app.vercel.app
# AI requests allowed per user per hour (per server instance).
AI_REQUESTS_PER_HOUR=80
